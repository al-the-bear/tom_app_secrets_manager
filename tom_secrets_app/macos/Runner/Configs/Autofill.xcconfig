// The app's App Group and the macOS AutoFill provider (part-os-integration,
// DP-50; part-browser, Safari): the App Group that holds the AutoFill
// snapshot and the service's client socket the Safari extension reaches,
// and the keychain access group that holds the snapshot's key, all named by
// the Apple Developer team. TSM_TEAM_ID stays empty until the team-signed
// build (tsm_finalize_user12, DP-176): the app, the provider, the Safari
// extension and the service then find no group (it reads `.tom.secrets`).
TSM_TEAM_ID =
TSM_APP_GROUP = $(TSM_TEAM_ID).tom.secrets
TSM_AUTOFILL_APP_GROUP = $(TSM_APP_GROUP)
TSM_AUTOFILL_KEYCHAIN_GROUP = $(TSM_TEAM_ID).tom.secrets.autofill
