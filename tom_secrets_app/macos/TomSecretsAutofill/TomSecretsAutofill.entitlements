<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The AutoFill provider runs sandboxed: it reads the snapshot from the App
	  Group container and its key from the shared keychain access group, and
	  nothing else. These entitlements need the team's provisioning profile
	  (DP-176): the extension is built and embedded in the team-signed build.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TSM_AUTOFILL_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(TSM_AUTOFILL_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
