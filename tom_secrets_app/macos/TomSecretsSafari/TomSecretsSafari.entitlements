<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The Safari Web Extension's handler runs sandboxed. It starts the
	  browser host from the app's tools folder (the host inherits the
	  sandbox) and reaches the service only through the client socket in the
	  App Group container. The App Group needs the team's provisioning
	  profile (DP-176): the extension is embedded in the team-signed build.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TSM_APP_GROUP)</string>
	</array>
</dict>
</plist>
